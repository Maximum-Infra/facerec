# FaceRec LAB configuration
POSTGRES_DB=facerec
POSTGRES_USER=facerec
POSTGRES_PASSWORD=change-me-lab-password
DATABASE_URL=postgresql+psycopg://facerec:change-me-lab-password@db:5432/facerec

# Confirmed Minrray lab stream (H.264, 1920x1080, 15 FPS)
RTSP_URL=rtsp://<CAMERA_USER>:<CAMERA_PASSWORD>@<CAMERA_IP>:554/live/av0
RTSP_TRANSPORT=tcp

# Change both values together if you change this lab token.
INTERNAL_TOKEN=change-me-internal-token
API_INTERNAL_URL=http://api:8091
WORKER_URL=http://worker:8092

# Calibrated Phase 2 entrance values.
MATCH_THRESHOLD=0.60
MATCH_MARGIN=0.04
DETECTION_SCORE_THRESHOLD=0.85
MIN_FACE_WIDTH=120
MIN_BLUR_SCORE=55
PROCESS_WIDTH=960
INFERENCE_FPS=5
ENROLLMENT_SAMPLES=15
EVENT_COOLDOWN_SECONDS=4

# Phase 3 experimental RGB challenge. These values do not grant access.
ANTI_SPOOF_STEP_TIMEOUT_SECONDS=12
ANTI_SPOOF_CONFIRM_FRAMES=3
ANTI_SPOOF_TURN_DELTA=0.10
ANTI_SPOOF_CLOSER_RATIO=1.18
ANTI_SPOOF_CONTINUITY_THRESHOLD=0.50

# Phase 4A automatic evidence-retention scheduler.
RETENTION_CHECK_SECONDS=3600

# v0.4.2 lab event actions. Disabled until a protected receiver is configured.
ACTION_WEBHOOK_ENABLED=false
ACTION_WEBHOOK_URL=http://<PI_IP>:1880/facerec/event
ACTION_WEBHOOK_TOKEN=
ACTION_WEBHOOK_TIMEOUT_SECONDS=8
